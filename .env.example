ANALYZER_USER=admin
ANALYZER_PASSWORD=replace-with-a-long-unique-password

# PlayerAuctions: public catalog in a separate browser profile; no API keys.
# Optional local HTTP/SOCKS5 proxy, used only by this collector.
# PLAYERAUCTIONS_PROXY_URL=socks5://127.0.0.1:40000
# Linux uses Chromium + Xvfb. Set true to use headless Chromium instead.
# PLAYERAUCTIONS_HEADLESS=false
